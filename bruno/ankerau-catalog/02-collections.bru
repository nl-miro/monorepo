meta {
  name: 02 collections
  type: http
  seq: 2
}

post {
  url: https://oneanker-au.myshopify.com/api/2026-10/graphql.json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "query CatalogCollections($after: String, $itemAfter: String) @inContext(country:AU, language:EN) { products(first:5,after:$after,sortKey:ID) { pageInfo { hasNextPage endCursor } nodes { ...ProductFields } } } fragment ProductFields on Product { id collections(first:10,after:$itemAfter) { pageInfo { hasNextPage endCursor } edges { cursor node { __typename description descriptionHtml handle id image { __typename altText height id thumbhash url width } onlineStoreUrl seo { __typename description title } title updatedAt } } } }",
    "variables": {
      "after": null,
      "itemAfter": null
    }
  }
}
