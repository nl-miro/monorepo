//! Turns normalized data into the product variations the rest of the system consumes: which
//! facts describe the product as a whole and which belong to one variation.
//!
//! The storefront renders the same offer twice - as a schema.org island and as its own product
//! record - and normalization keeps both. This is where they become one variation per variant,
//! each field taken from whichever rendering states it cleanly.

use super::normalized::{self, AnkerCaNormalizedDocument};
use crate::shared::{
    IdentifierError, ShopifyHandle, ShopifyProductGid, ShopifyProductVariationGid, Sku,
};
use chrono::{DateTime, Utc};
use money::Money;
use serde::Serialize;
use thiserror::Error;

#[derive(Debug, Clone, PartialEq, Error)]
pub enum StructuralizeError {
    #[error("variant `{variant_id}` selects no option, so nothing names which variation it is")]
    VariantWithoutOptions { variant_id: String },

    #[error(
        "variant `{variant_id}` selects option `{option_name}`, which the product does not offer"
    )]
    UnknownSelectedOption {
        variant_id: String,
        option_name: String,
    },

    #[error(transparent)]
    Identifier(#[from] IdentifierError),
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct AnkerCaDocument {
    pub variations: Vec<ProductVariation>,
}

impl AnkerCaDocument {
    pub fn from_normalized(
        input: AnkerCaNormalizedDocument,
    ) -> Result<AnkerCaDocument, StructuralizeError> {
        let AnkerCaNormalizedDocument { ld_json, product } = input;
        let island = ld_json.product;

        let variations_count = product.variants.len();
        let mut variations = Vec::with_capacity(variations_count);

        for variant in &product.variants {
            let identifiers = ProductVariationIdentifier::from_normalized(&product, variant)?;
            let pricing = ProductVariationPricing::from_normalized(variant);
            let logistics = ProductVariationLogistics::from_normalized(variant);
            let url = variation_url(
                &island.url,
                &identifiers.shopify_product_variation_gid,
                variations_count,
            )?;
            let content = Content::from_normalized(&island, &product, variant, url);
            let options = variation_options(&product, variant)?;

            variations.push(ProductVariation {
                identifiers,
                pricing,
                content,
                logistics,
                options,
            });
        }

        Ok(AnkerCaDocument { variations })
    }
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductVariation {
    pub identifiers: ProductVariationIdentifier,
    pub pricing: ProductVariationPricing,
    pub content: Content,
    pub logistics: ProductVariationLogistics,
    pub options: Vec<ProductVariationOption>,
}

/// No GTIN is available: the storefront's query does not select a barcode.
#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductVariationIdentifier {
    pub sku: Sku,
    pub shopify_product_gid: ShopifyProductGid,
    pub shopify_product_variation_gid: ShopifyProductVariationGid,
    pub shopify_handle: ShopifyHandle,
}

impl ProductVariationIdentifier {
    fn from_normalized(
        product: &normalized::product::ProductRecord,
        variant: &normalized::product::ProductVariant,
    ) -> Result<ProductVariationIdentifier, StructuralizeError> {
        Ok(ProductVariationIdentifier {
            sku: variant.sku.clone().try_into()?,
            shopify_product_gid: product.id.clone().try_into()?,
            shopify_product_variation_gid: variant.id.clone().try_into()?,
            shopify_handle: product.handle.clone().try_into()?,
        })
    }
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductVariationPricing {
    pub price: Money,
    /// `None` where the variant is not marked down.
    pub compare_at_price: Option<Money>,
}

impl ProductVariationPricing {
    fn from_normalized(variant: &normalized::product::ProductVariant) -> ProductVariationPricing {
        ProductVariationPricing {
            price: variant.price.clone(),
            compare_at_price: variant.compare_at_price.clone(),
        }
    }
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct Content {
    pub name: String,
    pub title: String,
    pub cta: String,
    pub description: String,
    /// The island's, which renders `Anker` across the storefront.
    pub brand: String,
    /// The record's, which names the sub-brand - `Eufy`, `Soundcore` - that `brand` flattens away.
    pub vendor: String,
    /// `None` where the variant has no image.
    pub image: Option<ProductVariationImage>,
    pub images: Vec<String>,
    pub url: String,
    pub published_at: DateTime<Utc>,
    pub product_type: Option<String>,
}

impl Content {
    fn from_normalized(
        island: &normalized::ldjson::Product,
        product: &normalized::product::ProductRecord,
        variant: &normalized::product::ProductVariant,
        url: String,
    ) -> Content {
        Content {
            name: variant.title.clone(),
            // Record titles contain `<b>` markup on some pages; island names are plain text.
            title: island.name.clone(),
            cta: island.description.clone(),
            description: product.description.clone(),
            brand: island.brand.clone(),
            vendor: product.vendor.clone(),
            image: variant.image.as_ref().map(|image| ProductVariationImage {
                url: image.url.clone(),
            }),
            images: gallery(product),
            url,
            published_at: product.published_at,
            product_type: product_type(&product.product_type),
        }
    }
}

// The record's gallery rather than the island's `images`, which despite its name renders one URL.
fn gallery(product: &normalized::product::ProductRecord) -> Vec<String> {
    product
        .images
        .iter()
        .map(|image| image.url.clone())
        .collect()
}

// A product with no type renders an empty string rather than omitting the field.
fn product_type(raw: &str) -> Option<String> {
    (!raw.is_empty()).then(|| raw.to_string())
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductVariationImage {
    pub url: String,
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductVariationLogistics {
    pub quantity_available: i64,
    pub available_for_sale: bool,
    pub requires_shipping: bool,
    /// Probably pounds; the payload states no unit. `None` where the variant is unweighed.
    pub weight: Option<f64>,
}

impl ProductVariationLogistics {
    fn from_normalized(variant: &normalized::product::ProductVariant) -> ProductVariationLogistics {
        ProductVariationLogistics {
            quantity_available: variant.quantity_available,
            available_for_sale: variant.available_for_sale,
            requires_shipping: variant.requires_shipping,
            weight: variant.weight,
        }
    }
}

/// One option this variation is the value of, e.g. `Color` / `Black`.
#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductVariationOption {
    pub id: String,
    pub name: String,
    pub value: String,
}

// Only the product's option list supplies IDs; variants select options by name.
fn variation_options(
    product: &normalized::product::ProductRecord,
    variant: &normalized::product::ProductVariant,
) -> Result<Vec<ProductVariationOption>, StructuralizeError> {
    if variant.selected_options.is_empty() {
        return Err(StructuralizeError::VariantWithoutOptions {
            variant_id: variant.id.clone(),
        });
    }

    variant
        .selected_options
        .iter()
        .map(|selected| {
            let offered = product
                .options
                .iter()
                .find(|option| option.name == selected.name)
                .ok_or_else(|| StructuralizeError::UnknownSelectedOption {
                    variant_id: variant.id.clone(),
                    option_name: selected.name.clone(),
                })?;

            Ok(ProductVariationOption {
                id: offered.id.clone(),
                name: selected.name.clone(),
                value: selected.value.clone(),
            })
        })
        .collect()
}

// The island supplies a clean base URL in the inspected corpus, without queries or HTML escaping.
fn variation_url(
    island_url: &str,
    gid: &ShopifyProductVariationGid,
    variations: usize,
) -> Result<String, StructuralizeError> {
    if variations < 2 {
        return Ok(island_url.to_owned());
    }

    Ok(format!("{}?variant={}", island_url, gid.numeric_id()?))
}

#[cfg(test)]
mod tests {
    use super::{AnkerCaDocument, StructuralizeError};
    use crate::ankerca::offer_details::v1::normalized::AnkerCaNormalizedDocument;
    use crate::shared::IdentifierError;
    use html_extractor::serde_json::{self, Value, json};

    #[test]
    fn a_single_variant_document_gets_the_bare_island_url() {
        let mut input = normalized_document();
        input["product"]["variants"] = json!([variant("1", "A3331Z01", "Black")]);

        assert_eq!(
            urls(&structuralized(&input)),
            vec!["https://www.anker.com/ca-fr/products/a3331-c40i-clip-earbuds"]
        );
    }

    #[test]
    fn each_variation_of_a_multi_variant_document_gets_its_own_url() {
        assert_eq!(
            urls(&structuralized(&normalized_document())),
            vec![
                "https://www.anker.com/ca-fr/products/a3331-c40i-clip-earbuds?variant=1",
                "https://www.anker.com/ca-fr/products/a3331-c40i-clip-earbuds?variant=2",
            ]
        );
    }

    #[test]
    fn the_title_comes_from_the_island_so_record_markup_does_not_cross() {
        let mut input = normalized_document();
        input["product"]["title"] = json!("Hub USB-C Anker <b>332</b> (5 en 1)");
        input["ld_json"]["product"]["name"] = json!("Hub USB-C Anker 332 (5 en 1)");

        let output = structuralized(&input);

        assert_eq!(
            output["variations"][0]["content"]["title"],
            json!("Hub USB-C Anker 332 (5 en 1)")
        );
        assert!(
            !output.to_string().contains("<b>"),
            "the record's markup must not reach any field of the document"
        );
    }

    #[test]
    fn the_gallery_comes_from_the_record_not_the_islands_single_url() {
        let output = structuralized(&normalized_document());

        assert_eq!(
            output["variations"][0]["content"]["images"],
            json!([
                "https://cdn.shopify.com/one.png",
                "https://cdn.shopify.com/two.png"
            ])
        );
    }

    #[test]
    fn a_page_without_images_structuralizes_without_them() {
        let mut input = normalized_document();
        input["ld_json"]["product"]["images"] = Value::Null;
        input["product"]["featured_image"] = Value::Null;
        input["product"]["images"] = json!([]);
        let mut only = variant("1", "A3968Z21", "White");
        only["image"] = Value::Null;
        input["product"]["variants"] = json!([only]);

        let content = structuralized(&input)["variations"][0]["content"].clone();

        assert_eq!(content["image"], Value::Null);
        assert_eq!(content["images"], json!([]));
    }

    #[test]
    fn the_brand_and_the_vendor_both_cross() {
        let content = structuralized(&normalized_document())["variations"][0]["content"].clone();

        assert_eq!(content["brand"], json!("Anker"));
        assert_eq!(content["vendor"], json!("Soundcore"));
    }

    #[test]
    fn the_option_id_is_recovered_from_the_products_own_list() {
        let output = structuralized(&normalized_document());

        assert_eq!(
            output["variations"][0]["options"],
            json!([{
                "id": "gid://shopify/ProductOption/9",
                "name": "Color",
                "value": "Black",
            }])
        );
    }

    #[test]
    fn a_selected_option_the_product_does_not_offer_fails_the_document() {
        let mut input = normalized_document();
        input["product"]["variants"][0]["selected_options"] =
            json!([{"name": "Size", "value": "Black"}]);

        assert_eq!(
            error(&input),
            StructuralizeError::UnknownSelectedOption {
                variant_id: "gid://shopify/ProductVariant/1".to_string(),
                option_name: "Size".to_string(),
            }
        );
    }

    #[test]
    fn a_variant_that_selects_no_option_fails_the_document() {
        let mut input = normalized_document();
        input["product"]["variants"][0]["selected_options"] = json!([]);

        assert_eq!(
            error(&input),
            StructuralizeError::VariantWithoutOptions {
                variant_id: "gid://shopify/ProductVariant/1".to_string(),
            }
        );
    }

    #[test]
    fn an_empty_sku_fails_the_document() {
        let mut input = normalized_document();
        input["product"]["variants"][0]["sku"] = json!("");

        assert_eq!(
            error(&input),
            StructuralizeError::Identifier(IdentifierError::EmptySku)
        );
    }

    #[test]
    fn a_variant_id_without_a_numeric_tail_fails_the_document() {
        let mut input = normalized_document();
        input["product"]["variants"][0]["id"] = json!("gid://shopify/ProductVariant/not-a-number");

        let message = structuralize_error_message(&input);

        assert!(
            message.contains("does not end in a numeric id"),
            "unexpected message: {message}"
        );
    }

    #[test]
    fn a_document_without_a_product_island_never_reaches_this_stage() {
        let mut input = normalized_document();
        input["ld_json"]["product"] = Value::Null;

        serde_json::from_value::<AnkerCaNormalizedDocument>(input)
            .expect_err("normalization requires the island, so it cannot be absent here");
    }

    #[test]
    fn availability_does_not_cross_into_any_variation() {
        for island in ["in_stock", "out_of_stock"] {
            let mut input = normalized_document();
            input["ld_json"]["product"]["offer"]["availability"] = json!(island);

            let output = structuralized(&input);

            assert!(
                !output.to_string().contains("availability"),
                "the island's product-level stock state must not be projected onto a variation"
            );
            assert_eq!(
                output["variations"][0]["logistics"]["available_for_sale"],
                json!(true)
            );
        }
    }

    #[test]
    fn an_unweighed_variant_crosses_as_absent_rather_than_zero() {
        let mut input = normalized_document();
        input["product"]["variants"][0]["weight"] = Value::Null;

        assert_eq!(
            structuralized(&input)["variations"][0]["logistics"]["weight"],
            Value::Null
        );
        assert_eq!(
            structuralized(&input)["variations"][1]["logistics"]["weight"],
            json!(0.3616)
        );
    }

    #[test]
    fn an_empty_product_type_crosses_as_absent() {
        let mut input = normalized_document();
        input["product"]["product_type"] = json!("");

        assert_eq!(
            structuralized(&input)["variations"][0]["content"]["product_type"],
            Value::Null
        );
    }

    fn variant(id: &str, sku: &str, color: &str) -> Value {
        json!({
            "id": format!("gid://shopify/ProductVariant/{id}"),
            "title": color,
            "sku": sku,
            "available_for_sale": true,
            "requires_shipping": true,
            "quantity_available": 34,
            "price": {"amount": 10999, "currency": "CAD"},
            "compare_at_price": null,
            "weight": 0.3616,
            "image": {"url": "https://cdn.shopify.com/variant.png"},
            "selected_options": [{"name": "Color", "value": color}],
            "selling_plan_allocations": [],
        })
    }

    fn normalized_document() -> Value {
        json!({
            "ld_json": {
                "product": {
                    "name": "soundcore C40i | Clip-On Open Earbuds",
                    "description": "Ultra-flexible clip-on open earbuds.",
                    "images": "https://cdn.shopify.com/island-only.png",
                    "url": "https://www.anker.com/ca-fr/products/a3331-c40i-clip-earbuds",
                    "brand": "Anker",
                    "offer": {
                        "availability": "in_stock",
                        "price": {"amount": 10999, "currency": "CAD"},
                    },
                },
            },
            "product": {
                "id": "gid://shopify/Product/8302268514493",
                "handle": "a3331-c40i-clip-earbuds",
                "title": "soundcore C40i | Clip-On Open Earbuds",
                "vendor": "Soundcore",
                "product_type": "Earbuds",
                "description": "The record's own copy, which differs from the island's.",
                "available_for_sale": true,
                "created_at": "2026-05-13T10:27:03Z",
                "updated_at": "2026-09-01T03:18:48Z",
                "published_at": "2026-05-25T03:41:47Z",
                "seo": {"title": null, "description": null},
                "price": {"amount": 10999, "currency": "CAD"},
                "compare_at_price": null,
                "featured_image": {"url": "https://cdn.shopify.com/one.png"},
                "images": [
                    {"url": "https://cdn.shopify.com/one.png"},
                    {"url": "https://cdn.shopify.com/two.png"},
                ],
                "options": [{
                    "id": "gid://shopify/ProductOption/9",
                    "name": "Color",
                    "values": ["Black", "Midnight"],
                }],
                "variants": [variant("1", "A3331Z01", "Black"), variant("2", "A3331Z02", "Midnight")],
                "selling_plan_groups": [],
            },
        })
    }

    fn structuralized(input: &Value) -> Value {
        let result = crate::ankerca::offer_details::v1::structuralize(&input.to_string())
            .expect("the normalized document structuralizes");

        let document_json = result
            .document_json
            .expect("ankerca hands over a structuralized document");

        serde_json::from_str(&document_json).expect("the document is JSON")
    }

    fn structuralize_error_message(input: &Value) -> String {
        match crate::ankerca::offer_details::v1::structuralize(&input.to_string()) {
            Err(message) => message,
            Ok(_) => panic!("the document must fail to structuralize"),
        }
    }

    fn error(input: &Value) -> StructuralizeError {
        let normalized: AnkerCaNormalizedDocument =
            serde_json::from_value(input.clone()).expect("the fixture is a normalized document");

        AnkerCaDocument::from_normalized(normalized)
            .expect_err("the document must fail to structuralize")
    }

    fn urls(output: &Value) -> Vec<String> {
        output["variations"]
            .as_array()
            .expect("variations is a list")
            .iter()
            .map(|variation| variation["content"]["url"].as_str().unwrap().to_string())
            .collect()
    }
}
